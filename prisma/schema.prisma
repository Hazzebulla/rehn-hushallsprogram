generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COMPANY_OWNER
  ADMIN
  SUPERVISOR
  WORKER
  CUSTOMER
}

enum AuthProvider {
  EMAIL
  MAGIC_LINK
  BANKID
  GOOGLE
  MICROSOFT
}

enum DocumentVisibility {
  INTERNAL
  FIELD_TEAM
  CUSTOMER
}

enum GdprRequestType {
  EXPORT
  DELETE
  RECTIFY
}

enum GdprRequestStatus {
  REQUESTED
  VERIFYING_IDENTITY
  PROCESSING
  COMPLETED
  REJECTED
}

enum BackupStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  WAITING_FOR_CUSTOMER
  READY_FOR_INVOICING
  COMPLETED
  ARCHIVED
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  INVOICED
}

enum ComponentStatus {
  GREEN
  YELLOW
  ORANGE
  RED
  GREY
}

enum ProductDataQuality {
  verified_manual
  manufacturer_source
  supplier_source
  estimated
  unverified
}

enum ProductImportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Company {
  id           String          @id @default(cuid())
  name         String
  orgNo        String
  users        User[]
  customers    Customer[]
  projects     Project[]
  properties   Property[]
  documents    DocumentAsset[]
  gdprRequests GdprRequest[]
  backupJobs   BackupJob[]
  auditLogs    AuditLog[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model User {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String
  role         Role
  active       Boolean       @default(true)
  lastLoginAt  DateTime?
  authAccounts AuthAccount[]
  sessions     AuthSession[]
  createdAt    DateTime      @default(now())

  @@unique([companyId, email])
  @@index([companyId, role])
}

model AuthAccount {
  id                String       @id @default(cuid())
  companyId         String
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String
  passwordHash      String?
  mfaEnabled        Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([provider, providerAccountId])
  @@index([companyId, userId])
}

model AuthSession {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, userId, expiresAt])
}

model Customer {
  id            String                 @id @default(cuid())
  companyId     String
  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          String
  name          String
  orgOrPersonNo String?
  invoiceEmail  String?
  phone         String?
  paymentTerms  Int                    @default(30)
  projects      Project[]
  properties    Property[]
  portalAccount CustomerPortalAccount?
  documents     DocumentAsset[]
  gdprRequests  GdprRequest[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([companyId, name])
}

model Project {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  propertyId  String?
  property    Property?       @relation(fields: [propertyId], references: [id])
  number      String
  name        String
  status      ProjectStatus   @default(PLANNED)
  budgetCents Int             @default(0)
  workOrders  WorkOrder[]
  timeEntries TimeEntry[]
  materials   MaterialEntry[]
  quotes      Quote[]
  invoices    InvoiceBasis[]
  documents   DocumentAsset[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status])
}

model WorkOrder {
  id          String      @id @default(cuid())
  companyId   String
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  scheduledAt DateTime?
  priority    String      @default("NORMAL")
  status      String      @default("ASSIGNED")
  timeEntries TimeEntry[]
  createdAt   DateTime    @default(now())

  @@index([companyId, scheduledAt])
}

model TimeEntry {
  id          String         @id @default(cuid())
  companyId   String
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workOrderId String?
  workOrder   WorkOrder?     @relation(fields: [workOrderId], references: [id])
  userId      String
  minutes     Int
  workType    String
  description String?
  status      ApprovalStatus @default(DRAFT)
  invoiceId   String?
  createdAt   DateTime       @default(now())

  @@index([companyId, status])
  @@index([companyId, invoiceId])
}

model MaterialEntry {
  id         String         @id @default(cuid())
  companyId  String
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  quantity   Decimal
  unit       String
  costCents  Int
  salesCents Int
  status     ApprovalStatus @default(DRAFT)
  invoiceId  String?
  createdAt  DateTime       @default(now())

  @@index([companyId, status])
  @@index([companyId, invoiceId])
}

model Quote {
  id         String    @id @default(cuid())
  companyId  String
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  customerId String
  version    Int
  status     String    @default("DRAFT")
  acceptedAt DateTime?
  acceptedBy String?
  acceptedIp String?
  totalCents Int       @default(0)
  createdAt  DateTime  @default(now())

  @@unique([companyId, id, version])
  @@index([companyId, status])
}

model InvoiceBasis {
  id         String   @id @default(cuid())
  companyId  String
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status     String   @default("DRAFT")
  totalCents Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([companyId, status])
}

model Property {
  id                 String               @id @default(cuid())
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer             @relation(fields: [customerId], references: [id])
  propertyNo         String?
  type               String
  address            String
  buildYear          Int?
  healthScore        PropertyHealthScore?
  buildings          Building[]
  rooms              Room[]
  systems            TechnicalSystem[]
  components         Component[]
  propertyComponents PropertyComponent[]
  inspections        Inspection[]
  plans              MaintenancePlan[]
  projects           Project[]
  documents          DocumentAsset[]
  houseReports       HouseReport[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([companyId, customerId])
}

model Building {
  id         String   @id @default(cuid())
  companyId  String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  units      Unit[]
}

model Unit {
  id         String   @id @default(cuid())
  companyId  String
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  label      String
  rooms      Room[]
}

model Room {
  id         String      @id @default(cuid())
  companyId  String
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId     String?
  unit       Unit?       @relation(fields: [unitId], references: [id])
  name       String
  components Component[]
}

model TechnicalSystem {
  id         String      @id @default(cuid())
  companyId  String
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  category   String
  components Component[]
}

model ComponentType {
  id                    String          @id @default(cuid())
  companyId             String
  name                  String
  category              String
  normalLifeYears       Int
  serviceIntervalMonths Int?
  components            Component[]
  rules                 LifecycleRule[]

  @@unique([companyId, name])
}

model Component {
  id                     String                @id @default(cuid())
  companyId              String
  propertyId             String
  property               Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  typeId                 String
  type                   ComponentType         @relation(fields: [typeId], references: [id])
  roomId                 String?
  room                   Room?                 @relation(fields: [roomId], references: [id])
  systemId               String?
  system                 TechnicalSystem?      @relation(fields: [systemId], references: [id])
  productModelId         String?
  productModel           ProductModel?         @relation(fields: [productModelId], references: [id])
  brand                  String?
  model                  String?
  serialNo               String?
  installedAt            DateTime?
  estimatedYear          Int?
  estimateCertainty      String?
  adjustedLifeYears      Int?
  condition              String                @default("UNKNOWN")
  riskLevel              String                @default("UNKNOWN")
  criticality            String                @default("NORMAL")
  status                 ComponentStatus       @default(GREY)
  replacementCostCents   Int                   @default(0)
  plannedReplacementYear Int?
  inspections            ComponentInspection[]
  planItems              MaintenancePlanItem[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([companyId, propertyId, status])
  @@index([companyId, productModelId])
}

model Manufacturer {
  id        String         @id @default(cuid())
  name      String         @unique
  website   String?
  models    ProductModel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ProductModel {
  id                       String              @id @default(cuid())
  manufacturerId           String
  manufacturer             Manufacturer        @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  rskNumber                String?
  productName              String?
  category                 String
  modelName                String
  systemType               String?
  technicalDescription     String?
  productImageUrl          String?
  unit                     String              @default("st")
  productionStartYear      Int?
  productionEndYear        Int?
  outputMinKw              Float?
  outputMaxKw              Float?
  tankVolumeLitres         Int?
  connectionSize           String?
  dimensions               String?
  controlSystem            String?
  expectedLifetimeMinYears Int?
  expectedLifetimeMaxYears Int?
  replacementPriceMinSek   Int?
  replacementPriceMaxSek   Int?
  sourceUrl                String?
  manualUrl                String?
  wiringDiagramUrl         String?
  dataQuality              ProductDataQuality  @default(unverified)
  lastVerifiedAt           DateTime?
  active                   Boolean             @default(true)
  components               Component[]
  propertyComponents       PropertyComponent[]
  favorites                ProductFavorite[]
  usage                    ProductUsage[]
  supplierPrices           ProductSupplierPrice[]
  estimateMaterialRows     EstimateMaterialRow[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@unique([manufacturerId, category, modelName])
  @@index([category, active])
  @@index([rskNumber])
  @@index([modelName])
}

model Supplier {
  id        String                 @id @default(cuid())
  companyId String
  name      String
  active    Boolean                @default(true)
  prices    ProductSupplierPrice[]
  catalogProducts SupplierProduct[]
  priceLists SupplierPriceList[]
  priceImportBatches SupplierPriceImportBatch[]
  discounts SupplierDiscountRule[]
  discountImportBatches SupplierDiscountImportBatch[]
  productDiscountGroups ProductDiscountGroupMap[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([companyId, name])
  @@index([companyId, active])
}

model SupplierProduct {
  id                    String          @id @default(cuid())
  companyId             String
  supplierId            String
  supplier              Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierArticleNumber String
  rskNumber             String?
  supplierName          String
  calculationGroup      String?
  unit                  String?
  statusRaw             String?
  active                Boolean         @default(true)
  prices                SupplierPrice[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([companyId, supplierId, supplierArticleNumber])
  @@index([companyId, supplierId, supplierName])
  @@index([companyId, supplierId, calculationGroup])
  @@index([companyId, rskNumber])
}

model SupplierPriceList {
  id             String          @id @default(cuid())
  companyId      String
  supplierId     String
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  code           String
  name           String
  validFrom      DateTime?
  validTo        DateTime?
  active         Boolean         @default(true)
  importedAt     DateTime?
  sourceFileName String?
  fileHash       String?
  prices         SupplierPrice[]
  importBatches  SupplierPriceImportBatch[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([companyId, supplierId, code, validFrom, validTo])
  @@index([companyId, supplierId, active])
  @@index([companyId, supplierId, code])
}

model SupplierPrice {
  id                String            @id @default(cuid())
  companyId         String
  supplierId        String
  supplierProductId String
  supplierProduct   SupplierProduct   @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  priceListId       String
  priceList         SupplierPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  price             Decimal           @db.Decimal(12, 2)
  priceRawValue     String
  ntoRawValue       String?
  validFrom         DateTime?
  validTo           DateTime?
  importedAt        DateTime          @default(now())
  importBatchId     String?
  sourceRowNumber   Int?
  createdAt         DateTime          @default(now())

  @@unique([companyId, supplierProductId, priceListId, importBatchId])
  @@index([companyId, supplierId, priceListId])
  @@index([companyId, supplierProductId, validFrom, validTo])
}

model SupplierPriceImportBatch {
  id               String            @id @default(cuid())
  companyId        String
  supplierId       String
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  priceListId      String?
  priceList        SupplierPriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  sourceFileName   String
  fileHash         String
  importerType     String            @default("dahl-price-list-v1")
  status           String            @default("preview")
  priceListCode    String?
  validFrom        DateTime?
  validTo          DateTime?
  totalRows        Int               @default(0)
  productRows      Int               @default(0)
  validRows        Int               @default(0)
  invalidRows      Int               @default(0)
  ignoredRows      Int               @default(0)
  duplicateRows    Int               @default(0)
  existingProducts Int               @default(0)
  newProducts      Int               @default(0)
  updatedProducts  Int               @default(0)
  newPrices        Int               @default(0)
  priceChanges     Int               @default(0)
  importedBy       String?
  formatSummary    Json?
  rows             SupplierPriceImportRow[]
  createdAt        DateTime          @default(now())
  confirmedAt      DateTime?

  @@index([companyId, supplierId, status, createdAt])
  @@index([companyId, supplierId, fileHash])
}

model SupplierPriceImportRow {
  id                    String                   @id @default(cuid())
  companyId             String
  batchId               String
  batch                 SupplierPriceImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  supplierId            String
  rowNumber             Int
  originalRawRow         Json
  supplierArticleNumber String?
  rskNumber             String?
  supplierName          String?
  calculationGroup      String?
  unit                  String?
  priceRawValue         String?
  priceDecimal          Decimal?                 @db.Decimal(12, 2)
  ntoRawValue           String?
  priceListCode         String?
  statusRaw             String?
  validFrom             DateTime?
  validTo               DateTime?
  parseStatus           String                   @default("parsed")
  errorMessage          String?
  duplicateOfPriceId    String?
  importedProductId     String?
  importedPriceId       String?
  createdAt             DateTime                 @default(now())

  @@index([companyId, batchId, parseStatus])
  @@index([companyId, supplierId, supplierArticleNumber])
}

model ProductSupplierPrice {
  id             String       @id @default(cuid())
  companyId      String
  productModelId String
  productModel   ProductModel @relation(fields: [productModelId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierSku    String?
  listPriceOre   Int
  currency       String       @default("SEK")
  unit           String       @default("st")
  active         Boolean      @default(true)
  validFrom      DateTime?
  validTo        DateTime?
  sourceNote     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([companyId, productModelId, supplierId])
  @@index([companyId, supplierId, active])
  @@index([companyId, productModelId, active])
}

model SupplierDiscountRule {
  id               String    @id @default(cuid())
  companyId        String
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  manufacturerName String?
  category         String?
  productGroup     String?
  discountGroupCode String?
  priceLevel       String?
  rawDiscountValue String?
  importBatchId    String?
  rskNumber        String?
  discountPercent  Decimal   @db.Decimal(7, 3)
  validFrom        DateTime?
  validTo          DateTime?
  sourceNote       String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, supplierId, active])
  @@index([companyId, supplierId, discountGroupCode, priceLevel, active])
  @@index([companyId, rskNumber, active])
  @@index([companyId, manufacturerName, category, active])
}

model SupplierDiscountImportBatch {
  id               String                    @id @default(cuid())
  companyId        String
  supplierId       String
  supplier         Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sourceFileName   String
  status           String                    @default("preview")
  totalRows        Int                       @default(0)
  parsedRows       Int                       @default(0)
  ignoredRows      Int                       @default(0)
  errorRows        Int                       @default(0)
  duplicateRows    Int                       @default(0)
  importedRows     Int                       @default(0)
  importedBy       String?
  validFrom        DateTime?
  validTo          DateTime?
  parserVersion    String                    @default("pcl-fixed-v1")
  formatSummary    Json?
  rows             SupplierDiscountImportRow[]
  createdAt        DateTime                  @default(now())
  confirmedAt      DateTime?

  @@index([companyId, supplierId, status, createdAt])
}

model SupplierDiscountImportRow {
  id                String                      @id @default(cuid())
  companyId         String
  batchId           String
  batch             SupplierDiscountImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  supplierId        String
  rowNumber         Int
  originalRawLine   String
  discountGroupCode String?
  rawDiscountValue  String?
  description       String?
  priceLevel        String?
  validityDate      DateTime?
  parseStatus       String                      @default("parsed")
  errorMessage      String?
  duplicateOfRuleId String?
  importedRuleId    String?
  createdAt         DateTime                    @default(now())

  @@index([companyId, batchId, parseStatus])
  @@index([companyId, supplierId, discountGroupCode, priceLevel])
}

model ProductDiscountGroupMap {
  id                String    @id @default(cuid())
  companyId         String
  supplierId        String
  supplier          Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rskNumber         String
  discountGroupCode String
  validFrom         DateTime?
  validTo           DateTime?
  sourceNote        String?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([companyId, supplierId, rskNumber, discountGroupCode])
  @@index([companyId, supplierId, rskNumber, active])
}

model PricingSettings {
  id                         String   @id @default(cuid())
  companyId                  String   @unique
  preferredSupplierId        String?
  autoSelectLowestNetPrice   Boolean  @default(false)
  standardHourlyRateOre      Int      @default(69500)
  materialMarkupPercent      Decimal  @default(35) @db.Decimal(7, 3)
  serviceVehicleFeeOre       Int      @default(49500)
  minimumBillingMinutes      Int      @default(60)
  vatPercent                 Decimal  @default(25) @db.Decimal(7, 3)
  rotEnabledByDefault        Boolean  @default(false)
  rotDeductionPercent        Decimal  @default(30) @db.Decimal(7, 3)
  rotMaxDeductionOre         Int      @default(5000000)
  customerRoundingIncrementOre Int    @default(100)
  estimateValidityDays       Int      @default(30)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model MaterialMarkupRule {
  id            String   @id @default(cuid())
  companyId     String
  productModelId String?
  category      String?
  markupPercent Decimal  @db.Decimal(7, 3)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, productModelId, active])
  @@index([companyId, category, active])
}

model ActionTemplate {
  id                    String   @id @default(cuid())
  companyId             String
  name                  String
  category              String
  description           String?
  defaultWorkMinutes    Int      @default(60)
  defaultConsumablesOre Int      @default(0)
  defaultOtherCostOre   Int      @default(0)
  recommendedProductModelId String?
  rotEligible           Boolean  @default(true)
  requiresQuote         Boolean  @default(false)
  active                Boolean  @default(true)
  estimates             ActionEstimate[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, category, active])
}

model ActionEstimate {
  id                    String                @id @default(cuid())
  companyId             String
  reportId              String
  report                HouseReport           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  findingId             String?
  recommendedActionId   String?
  actionTemplateId      String?
  actionTemplate        ActionTemplate?       @relation(fields: [actionTemplateId], references: [id])
  title                 String
  status                String                @default("draft")
  priceMode             String                @default("fixed")
  requiresQuote         Boolean               @default(false)
  rotSelected           String                @default("unknown")
  snapshot              Json
  subtotalOre           Int                   @default(0)
  vatOre                Int                   @default(0)
  totalInclVatOre       Int                   @default(0)
  rotDeductionOre       Int                   @default(0)
  customerTotalOre      Int                   @default(0)
  publishedPriceOre     Int?
  manualPriceOre        Int?
  manualPriceReason     String?
  approvedAt            DateTime?
  approvedBy            String?
  publishedAt           DateTime?
  publishedBy           String?
  materialRows          EstimateMaterialRow[]
  laborRows             EstimateLaborRow[]
  otherCostRows         EstimateOtherCostRow[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([companyId, reportId, status])
  @@index([companyId, actionTemplateId])
}

model EstimateMaterialRow {
  id                      String         @id @default(cuid())
  companyId               String
  estimateId              String
  estimate                ActionEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  productModelId          String?
  productModel            ProductModel?  @relation(fields: [productModelId], references: [id])
  description             String
  rskNumber               String?
  quantity                Decimal        @default(1) @db.Decimal(10, 3)
  unit                    String         @default("st")
  supplierName            String?
  listPriceOreAtEstimate  Int?
  discountPercentAtEstimate Decimal?     @db.Decimal(7, 3)
  netPriceOreAtEstimate   Int?
  markupPercentAtEstimate Decimal?       @db.Decimal(7, 3)
  customerUnitPriceOreAtEstimate Int
  totalCustomerPriceOre   Int
  snapshot                Json
  createdAt               DateTime       @default(now())
}

model EstimateLaborRow {
  id                    String         @id @default(cuid())
  companyId             String
  estimateId            String
  estimate              ActionEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  workType              String         @default("VVS-montör")
  minutes               Int
  standardMinutes       Int?
  hourlyRateOreAtEstimate Int
  rotEligible           Boolean        @default(true)
  totalOre              Int
  snapshot              Json
  createdAt             DateTime       @default(now())
}

model EstimateOtherCostRow {
  id                    String         @id @default(cuid())
  companyId             String
  estimateId            String
  estimate              ActionEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description           String
  quantity              Decimal        @default(1) @db.Decimal(10, 3)
  unitPriceOreAtEstimate Int
  totalOre              Int
  rotEligible           Boolean        @default(false)
  snapshot              Json
  createdAt             DateTime       @default(now())
}

model PropertyComponent {
  id                 String        @id @default(cuid())
  companyId          String
  propertyId         String
  property           Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  productModelId     String?
  productModel       ProductModel? @relation(fields: [productModelId], references: [id])
  customManufacturer String?
  customModelName    String?
  serialNumber       String?
  manufacturingYear  Int?
  installationYear   Int?
  condition          String?
  measuredValues     Json?
  notes              String?
  photos             Json?
  reviewStatus       String        @default("PROPERTY_ONLY")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([companyId, propertyId])
  @@index([companyId, productModelId])
  @@index([reviewStatus])
}

model ProductImportLog {
  id           String              @id @default(cuid())
  source       String
  status       ProductImportStatus @default(QUEUED)
  createdCount Int                 @default(0)
  updatedCount Int                 @default(0)
  skippedCount Int                 @default(0)
  errorCount   Int                 @default(0)
  errorDetails Json?
  startedAt    DateTime            @default(now())
  completedAt  DateTime?
}

model ProductFavorite {
  id             String       @id @default(cuid())
  companyId      String
  userId         String?
  productModelId String
  productModel   ProductModel @relation(fields: [productModelId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([companyId, userId, productModelId])
  @@index([companyId, createdAt])
}

model ProductUsage {
  id             String       @id @default(cuid())
  companyId      String
  productModelId String
  productModel   ProductModel @relation(fields: [productModelId], references: [id], onDelete: Cascade)
  usedAt         DateTime     @default(now())

  @@index([companyId, usedAt])
}

model ProductChangeLog {
  id             String   @id @default(cuid())
  companyId      String
  actorId        String?
  productModelId String?
  action         String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  @@index([companyId, productModelId])
}

model ComponentInspection {
  id              String          @id @default(cuid())
  companyId       String
  componentId     String
  component       Component       @relation(fields: [componentId], references: [id], onDelete: Cascade)
  inspectionId    String?
  inspectedAt     DateTime        @default(now())
  condition       String
  status          ComponentStatus
  remainingMonths Int?
  overrideReason  String?
}

model ComponentCondition {
  id        String @id @default(cuid())
  companyId String
  name      String
  score     Int

  @@unique([companyId, name])
}

model LifecycleRule {
  id              String        @id @default(cuid())
  companyId       String
  componentTypeId String
  componentType   ComponentType @relation(fields: [componentTypeId], references: [id], onDelete: Cascade)
  condition       String
  lifeDeltaYears  Int
  reason          String
}

model Inspection {
  id          String           @id @default(cuid())
  companyId   String
  propertyId  String
  property    Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type        String
  status      String           @default("DRAFT")
  performedAt DateTime?
  submissions FormSubmission[]
}

model MaintenancePlan {
  id           String                @id @default(cuid())
  companyId    String
  propertyId   String
  property     Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  horizonYears Int                   @default(20)
  version      Int                   @default(1)
  items        MaintenancePlanItem[]
  createdAt    DateTime              @default(now())
}

model MaintenancePlanItem {
  id                 String          @id @default(cuid())
  companyId          String
  planId             String
  plan               MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  componentId        String?
  component          Component?      @relation(fields: [componentId], references: [id])
  recommendedYear    Int
  action             String
  priority           String
  estimatedCostCents Int
  preliminary        Boolean         @default(true)
  status             String          @default("PLANNED")
}

model FormTemplate {
  id        String        @id @default(cuid())
  companyId String
  name      String
  audience  String
  versions  FormVersion[]
}

model FormVersion {
  id          String           @id @default(cuid())
  companyId   String
  templateId  String
  template    FormTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  schema      Json
  publishedAt DateTime?
  submissions FormSubmission[]

  @@unique([templateId, version])
}

model FormSubmission {
  id           String        @id @default(cuid())
  companyId    String
  versionId    String
  version      FormVersion   @relation(fields: [versionId], references: [id])
  inspectionId String?
  inspection   Inspection?   @relation(fields: [inspectionId], references: [id])
  status       String        @default("DRAFT")
  answers      FormAnswer[]
  houseReports HouseReport[]
  signedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
}

model FormAnswer {
  id           String         @id @default(cuid())
  companyId    String
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldKey     String
  value        Json
}

model ServiceAgreement {
  id            String                @id @default(cuid())
  companyId     String
  customerId    String
  propertyId    String?
  status        String                @default("DRAFT")
  startsAt      DateTime?
  bindingMonths Int                   @default(0)
  noticeMonths  Int                   @default(1)
  versions      AgreementVersion[]
  acceptances   AgreementAcceptance[]
}

model AgreementVersion {
  id          String           @id @default(cuid())
  companyId   String
  agreementId String
  agreement   ServiceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  version     Int
  terms       String
  createdAt   DateTime         @default(now())
}

model AgreementAcceptance {
  id          String           @id @default(cuid())
  companyId   String
  agreementId String
  agreement   ServiceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  versionId   String
  acceptedBy  String
  acceptedIp  String?
  acceptedAt  DateTime         @default(now())
}

model CustomerPortalAccount {
  id         String   @id @default(cuid())
  companyId  String
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email      String
  active     Boolean  @default(true)
}

model CustomerRequest {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  propertyId  String?
  componentId String?
  category    String
  priority    String
  description String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())

  @@index([companyId, status, priority])
}

model NotificationPreference {
  id         String  @id @default(cuid())
  companyId  String
  customerId String
  channel    String
  purpose    String
  enabled    Boolean @default(true)
}

model Notification {
  id         String    @id @default(cuid())
  companyId  String
  customerId String?
  channel    String
  purpose    String
  status     String
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
}

model PropertyHealthScore {
  id           String   @id @default(cuid())
  companyId    String
  propertyId   String   @unique
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  score        Int
  calculatedAt DateTime @default(now())
  explanation  Json
}

model HouseReport {
  id            String         @id @default(cuid())
  companyId     String
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  submissionId  String
  submission    FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reportNo      String
  status        String         @default("READY_FOR_REVIEW")
  formVersion   Int
  reportVersion Int            @default(1)
  generatedAt   DateTime       @default(now())
  reviewedAt    DateTime?
  publishedAt   DateTime?
  archivedAt    DateTime?
  performedAt   DateTime?
  performedBy   String?
  reportOwner   String?
  nextControl   String?
  qualityNotes  String?
  summary       Json?
  estimates     ActionEstimate[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([companyId, reportNo])
  @@unique([submissionId, reportVersion])
  @@index([companyId, propertyId, status])
}

model CustomerPreInspectionLink {
  id          String    @id @default(cuid())
  companyId   String
  token       String    @unique
  customerId  String?
  propertyId  String?
  submissionId String?
  reportId    String?
  status      String    @default("customer_form_started")
  payload     Json?
  sourceSummary Json?
  expiresAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, propertyId, status])
  @@index([companyId, customerId])
}

model OwnershipTransfer {
  id             String   @id @default(cuid())
  companyId      String
  propertyId     String
  currentOwnerId String
  newOwnerEmail  String
  status         String   @default("REQUESTED")
  createdAt      DateTime @default(now())
}

model Consent {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  type       String
  granted    Boolean
  source     String
  recordedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([companyId, entity, entityId])
}

model DocumentAsset {
  id             String             @id @default(cuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?          @relation(fields: [customerId], references: [id])
  propertyId     String?
  property       Property?          @relation(fields: [propertyId], references: [id])
  projectId      String?
  project        Project?           @relation(fields: [projectId], references: [id])
  title          String
  fileName       String
  mimeType       String
  storageKey     String
  checksumSha256 String
  sizeBytes      Int
  visibility     DocumentVisibility @default(INTERNAL)
  uploadedById   String?
  version        Int                @default(1)
  retainedUntil  DateTime?
  createdAt      DateTime           @default(now())

  @@index([companyId, customerId])
  @@index([companyId, propertyId])
  @@index([companyId, projectId])
  @@index([companyId, visibility])
}

model GdprRequest {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?         @relation(fields: [customerId], references: [id])
  type        GdprRequestType
  status      GdprRequestStatus @default(REQUESTED)
  requestedBy String
  verifiedAt  DateTime?
  completedAt DateTime?
  exportKey   String?
  notes       String?
  createdAt   DateTime          @default(now())

  @@index([companyId, status])
}

model BackupJob {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status         BackupStatus @default(QUEUED)
  scope          String
  storageKey     String?
  checksumSha256 String?
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?
  createdAt      DateTime     @default(now())

  @@index([companyId, status, createdAt])
}
